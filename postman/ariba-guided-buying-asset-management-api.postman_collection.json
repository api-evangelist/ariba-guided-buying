            "url": {
              "raw": "{{baseUrl}}/requisitions?realm=<string>&$filter=<string>&$count=<boolean>&$skip=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requisitions"
              ],
              "query": [
                {
                  "description": "(Required) The SAP Ariba realm name identifying your site.",
                  "key": "realm",
                  "value": "<string>"
                },
                {
                  "description": "Filter asset-based requisitions by attributes. Example: {TimeCreated eq 2018-09-26T09:00:00Z;TimeUpdated eq 2018-09-27T09:00:00Z}",
