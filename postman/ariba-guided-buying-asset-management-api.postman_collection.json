              "name": "assets",
              "item": [
                {
                  "name": "Ariba Guided Buying Update Asset Line Items on Requisitions",
                  "id": "095997ff-e7e0-4fc7-bdbf-400eec7fabfb",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"updates\": [\n    {\n      \"requisitionId\": \"<string>\",\n      \"lineItemId\": \"<string>\",\n      \"assetNumber\": \"<string>\"\n    },\n    {\n      \"requisitionId\": \"<string>\",\n      \"lineItemId\": \"<string>\",\n      \"assetNumber\": \"<string>\"\n    }\n  ]\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/requisitions/batch/assets?realm=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "requisitions",
                        "batch",
                        "assets"
                      ],
                      "query": [
                        {
                          "description": "(Required) The SAP Ariba realm name identifying your site.",
                          "key": "realm",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "Update the Asset field for asset items on requisitions with unique asset values. The requisitions in which all asset items are assigned with unique asset values move under the Completed tab in the Asset Workbench and purchase orders are created after those requisitions are fully approved. Maximum 20 records per request."
                  },
